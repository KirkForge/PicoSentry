# PicoSentry / PicoShogun / PicoDome Environment Variables
# Copy this file to .env.local and fill in values for your deployment.
# Lines starting with # are comments. Values shown are defaults.
# Names verified against picosentry/serve/config/settings.py, watch/config.py,
# and sandbox/daemon/daemon.py (2026-08). Not every supported variable is
# listed here; this file covers the common deployment surface.

# ── Core ────────────────────────────────────────────────────────────────
# Environment: "production" enables all security checks, "development" relaxes them
PICOSHOGUN_ENV=development
PICOSHOGUN_SECRET_KEY=                  # REQUIRED in production — min 32 chars, no placeholders
PICOSHOGUN_DEBUG=false

# ── API Server ──────────────────────────────────────────────────────────
PICOSHOGUN_API_HOST=127.0.0.1
PICOSHOGUN_API_PORT=8765
PICOSHOGUN_API_WORKERS=1
PICOSHOGUN_API_RELOAD=false
PICOSHOGUN_CORS_ORIGINS=http://localhost:8765
PICOSHOGUN_DOCS_URL=/docs
PICOSHOGUN_REDOC_URL=/redoc
# Concurrency / keep-alive knobs read by the uvicorn runner
PICOSHOGUN_LIMIT_CONCURRENCY=512
PICOSHOGUN_KEEP_ALIVE=30

# ── Database ────────────────────────────────────────────────────────────
PICOSHOGUN_DATABASE_BACKEND=sqlite      # "sqlite" or "postgres"
# Default sqlite path is <package>/picosentry/serve/picoshogun.db
PICOSHOGUN_DATABASE_PATH=
PICOSHOGUN_DATABASE_URL=postgresql://user:pass@localhost:5432/picoshogun
PICOSHOGUN_JOURNAL_MODE=WAL             # not ...DATABASE_JOURNAL_MODE
PICOSHOGUN_SYNCHRONOUS=NORMAL           # not ...DATABASE_SYNCHRONOUS

# ── Security ───────────────────────────────────────────────────────────
# JWT: HS256 by default; set JWT_PRIVATE_KEY (PEM or path) for RS256 + JWK kid rotation.
PICOSHOGUN_JWT_PRIVATE_KEY=
PICOSHOGUN_JWT_KID=picosentry-1
PICOSHOGUN_RATE_LIMIT_BACKEND=memory     # "memory", "sqlite", or "redis"
PICOSHOGUN_REDIS_URL=redis://localhost:6379/0
PICOSHOGUN_RATELIMIT_REDIS_FAIL_CLOSED=false  # true: 429 when redis unreachable instead of failing open
PICOSHOGUN_REQUIRE_SIGNED_PLUGINS=1      # Set to 1 in production
PICOSHOGUN_TRUSTED_PUBLIC_KEYS=          # Comma-separated Ed25519 hex keys
PICOSHOGUN_TRUSTED_PUBLIC_KEYS_FILE=     # One hex key per line
PICOSHOGUN_TRUSTED_PROXIES=
# TLS note: ssl_cert_path/ssl_key_path are NOT read from these env vars by the
# current settings code (settings.py hardcodes None; configure TLS via the
# JSON settings file or terminate TLS upstream). Kept here because boot-check
# error messages reference them.
PICOSHOGUN_SSL_CERT_PATH=
PICOSHOGUN_SSL_KEY_PATH=
# WebAuthn (FIDO2) MFA — rp_id must equal the origin's host
PICOSHOGUN_WEBAUTHN_RP_ID=localhost
PICOSHOGUN_WEBAUTHN_RP_NAME=PicoSentry
PICOSHOGUN_WEBAUTHN_ORIGIN=http://localhost:8765
# Account lockout
PICOSHOGUN_LOCKOUT_MAX_ATTEMPTS=5
PICOSHOGUN_LOCKOUT_WINDOW_MINUTES=15

# ── Backup encryption (AES-GCM) + offsite ───────────────────────────────
PICOSHOGUN_BACKUP_ENCRYPT_KEY=           # empty = plain tar.gz
PICOSHOGUN_BACKUP_S3_ENDPOINT=           # empty = no offsite upload
PICOSHOGUN_BACKUP_S3_BUCKET=
PICOSHOGUN_BACKUP_S3_ACCESS_KEY=
PICOSHOGUN_BACKUP_S3_SECRET_KEY=
PICOSHOGUN_BACKUP_S3_REGION=us-east-1

# ── Alerts ─────────────────────────────────────────────────────────────
# Discord/Slack read bare names, SMTP/email use the PICOSHOGUN_ prefix
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
PICOSHOGUN_SMTP_HOST=
PICOSHOGUN_SMTP_PORT=587
PICOSHOGUN_SMTP_USER=
PICOSHOGUN_SMTP_PASSWORD=
PICOSHOGUN_EMAIL_FROM=picoshogun@localhost
PICOSHOGUN_EMAIL_TO=

# ── Orchestrator ───────────────────────────────────────────────────────
PICOSHOGUN_SCANS_WORKSPACE_ROOT=         # REQUIRED for /api/v1/scans endpoint

# ── Plugins ────────────────────────────────────────────────────────────
PICOSHOGUN_PLUGIN_DIR=

# ── Logging ────────────────────────────────────────────────────────────
PICOSHOGUN_LOG_LEVEL=INFO                # DEBUG, INFO, WARNING, ERROR, CRITICAL
PICOSHOGUN_LOG_STRUCTURED=true

# ── OpenTelemetry (optional, serve) ────────────────────────────────────
# Uses the standard OTel variable name, not a PICOSHOGUN_ one
OTEL_EXPORTER_OTLP_ENDPOINT=

# ── PicoDome (Sandbox Daemon) ──────────────────────────────────────────
PICODOME_DAEMON_HOST=127.0.0.1
PICODOME_DAEMON_PORT=8443
PICODOME_ENTERPRISE_MODE=
PICODOME_API_TOKENS=                     # Comma-separated auth tokens
PICODOME_TLS_CERT=
PICODOME_TLS_KEY=
PICODOME_TLS_CA=
PICODOME_STORE_BACKEND=jsonl             # "jsonl" or "sqlite"
PICODOME_SQLITE_PATH=
PICODOME_CORS_ORIGINS=
PICODOME_GLOBAL_RPS=25.0
PICODOME_RATE_PER_SECOND=2.0
PICODOME_TIMEOUT=30
PICODOME_MAX_SCAN_TIMEOUT=300
PICODOME_REDIS_URL=redis://localhost:6379/0   # not REDIS_HOST/PORT
PICODOME_REDIS_ENABLED=
PICODOME_REDIS_TIMEOUT=3
PICODOME_MEMORY_LIMIT_MB=512
PICODOME_FILE_SIZE_LIMIT_MB=100
PICODOME_AUDIT_FSYNC=true
PICODOME_CLUSTER_TOKEN=

# ── PicoWatch (LLM Defense) ───────────────────────────────────────────
PICOWATCH_HOST=127.0.0.1
PICOWATCH_PORT=8766
PICOWATCH_ADMIN_HOST=127.0.0.1
PICOWATCH_ADMIN_PORT=9091
PICOWATCH_API_KEY=                        # REQUIRED for production (>= 32 chars)
PICOWATCH_MAX_PROMPT_SIZE=1000000
PICOWATCH_MAX_OUTPUT_SIZE=1000000
PICOWATCH_RATE_LIMIT=100
PICOWATCH_RATE_LIMIT_WINDOW=60
PICOWATCH_OTEL_ENDPOINT=
PICOWATCH_AUDIT_HMAC_KEY=                 # >= 32 chars; default is a random per-process key
PICOWATCH_TRUST_PROXY=                    # Set to "1" to trust X-Forwarded-For
